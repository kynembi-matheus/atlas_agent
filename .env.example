# Copie para .env OU mantenha .config/.env. O ambiente tem prioridade.
OPENAI_API_KEY=
# OPENAI_KEY também é aceito para compatibilidade com a instalação atual.
OPENAI_MODEL=gpt-4.1
OPENAI_VERIFY_SSL=true
# Para certificados internos, prefira SSL_CERT_FILE=C:/certificados/ca.pem
PG_MCP_URL=https://10.1.114.16/pg_mcp/mcp
# Neste ambiente foi autorizado MCP_VERIFY_SSL=false em .config/.env.
# Em outras instala??es, mantenha true e informe o certificado da CA.
MCP_VERIFY_SSL=true
# MCP_CA_BUNDLE=C:/certificados/ca.pem
MCP_API_KEY=
ALLOWED_DATABASES=[]
# Protege a API e downloads. Digite esta chave na interface, quando configurada.
APP_API_KEY=
# Login ScdAuth: habilite depois de configurar a chave pública e o destino real.
SSO_ENABLED=false
SSO_PUBLIC_KEY=
# Alternativa recomendada ao PEM inline:
# SSO_PUBLIC_KEY_PATH=.config/scdauth-public.pem
SSO_EXPECTED_TARGET=
SSO_EXPECTED_ISSUER=samsite
SSO_EXPECTED_AUDIENCE=
SSO_SESSION_SECONDS=28800
SSO_COOKIE_SECURE=true
ENVIRONMENT=production
# GET /login cria sessão SOMENTE com ENVIRONMENT=development E uv run app.py --development.
# O bypass funciona com SSO_ENABLED=false, sem chave pública ou target.
ENVIRONMENT_EMAIL=
ENVIRONMENT_NAME=
ENVIRONMENT_PROFILE=
ENVIRONMENT_ROLE=
ENVIRONMENT_FUNCTION=
ENVIRONMENT_DEPARTMENT=
ENVIRONMENT_UNIT_NUMBER=
ENVIRONMENT_UNIT_NAME=
ENVIRONMENT_PHOTO_URL=
# Opcionais para handoff code -> JWT (troca HTTPS, nunca herda MCP_VERIFY_SSL).
SSO_AUTH_BASE_URL=
SSO_EXCHANGE_SECRET=
# SSO_AUTH_CA_BUNDLE=C:/certificados/scdauth-ca.pem
DATA_DIR=data
DOCS_DIR=docs
MAX_AGENT_STEPS=20
MAX_QUERY_ROWS=5000
MAX_DATASET_ROWS=50000
MAX_UPLOAD_BYTES=52428800
MAX_CONCURRENT_RUNS=2
MAX_PENDING_RUNS=20
RUN_TIMEOUT_SECONDS=600
# Plugin de internet pública, sem chave adicional. TLS sempre verificado.
INTERNET_ENABLED=true
INTERNET_SEARCH_PROVIDER=openai
# Vazio reutiliza OPENAI_MODEL; opcionalmente escolha outro modelo compatível com web_search.
INTERNET_SEARCH_MODEL=
INTERNET_TIMEOUT_SECONDS=25
INTERNET_MAX_BYTES=1048576
# Limite por arquivo em Importe seus dados (500 MiB); não altera anexos persistentes.
MAX_TEMPORARY_UPLOAD_BYTES=524288000
MAX_TEMPORARY_EXPANDED_BYTES=2147483648
MAX_TEMPORARY_CHARACTERS=524288000
MAX_TEMPORARY_ROWS=1048576

# Armazenamento de consumo de IA (PostgreSQL independente do MCP)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
# Opcional: caminho para CA PEM do PostgreSQL (no Windows usa certificados confiáveis do sistema).
PGSSLROOTCERT=
