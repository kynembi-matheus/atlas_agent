# Copie para .env OU mantenha .config/.env. O ambiente tem prioridade.
OPENAI_API_KEY=
# OPENAI_KEY também é aceito para compatibilidade com a instalação atual.
OPENAI_MODEL=gpt-4.1
OPENAI_VERIFY_SSL=true
# Para certificados internos, prefira SSL_CERT_FILE=C:/certificados/ca.pem
PG_MCP_URL=https://10.1.114.16/pg_mcp/mcp
# Neste ambiente foi autorizado MCP_VERIFY_SSL=false em .config/.env.
# Em outras instala??es, mantenha true e informe o certificado da CA.
MCP_VERIFY_SSL=true
# MCP_CA_BUNDLE=C:/certificados/ca.pem
MCP_API_KEY=
ALLOWED_DATABASES=[]
# Protege a API e downloads. Digite esta chave na interface, quando configurada.
APP_API_KEY=
DATA_DIR=data
DOCS_DIR=docs
MAX_AGENT_STEPS=20
MAX_QUERY_ROWS=5000
MAX_DATASET_ROWS=50000
MAX_UPLOAD_BYTES=5242880
MAX_CONCURRENT_RUNS=2
MAX_PENDING_RUNS=20
RUN_TIMEOUT_SECONDS=600
